---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import { ArrowUpRight, ArrowDown, Plus, Asterisk, Plug, Network, Sparkles, PanelsTopLeft, Wallet, MessagesSquare, ShieldCheck } from '@lucide/astro';
const repo = 'https://github.com/tamaina/misskey-a';
const release = `${repo}/releases/tag/9000.0.0-beta.4`;
const changes = `${repo}/blob/9000.0.0-beta.4/CHANGELOG.md`;
const currentChanges = `${repo}/blob/31f01db50b1cbe4e9211cb03b249662b8ab61141/CHANGELOG.md`;
const features = [
 ['01','MCP で、外部ツールとつながる。','管理者が有効化すると、トークンの権限に沿って API を検出・呼び出し。メンションや返信などのイベント購読と、永続化された送信キューにも対応します。','MCP / OAuth・CIMD',Plug],
 ['02','ActivityPub の配送を、軽量に。','対応する相手には Ed25519 で署名。複数の公開鍵や受信時の鍵再取得に対応し、従来の RSA 鍵との互換性も維持しています。','Ed25519 / #16・#18・#19',Network],
 ['03','サーバーを越えて、装いも。','Tempura からアバターデコレーション連合の実装を移植。リモートユーザーのアバターデコレーションも反映されるようになります。','アバターデコレーション / #191',Sparkles],
 ['04','共有から投稿へ、クリップをデッキへ。','PWA に共有したファイルを投稿フォームへ引き継ぎ。デッキにはクリップ列を追加し、集めたノートをいつものタイムラインと並べて読めます。','PWA・デッキ / #17・#162',PanelsTopLeft]
];
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Misskey 9000 (9k) — いつものつながりに、次の工夫を。</title>
<meta name="description" content="Misskey 9000（9k）は、Misskey から派生したオープンソースの分散型SNSソフトウェア。MCP・OAuth連携、Ed25519対応、アバターデコレーション連合から開発基盤まで。公開済み beta.4 の機能と開発の現在地をご紹介します。"/>
<link rel="canonical" href="https://mk9k.a9z.dev/"/><link rel="icon" href="/favicon.ico" sizes="48x48"/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
<link rel="manifest" href="/site.webmanifest"/>
<meta name="theme-color" content="#253bd3"/>
<meta property="og:type" content="website"/><meta property="og:locale" content="ja_JP"/><meta property="og:site_name" content="Misskey 9000"/><meta property="og:title" content="Misskey 9000 — いつものつながりに、次の工夫を。"/><meta property="og:description" content="Misskey から派生した、オープンソースの分散型SNSソフトウェア。9k の機能と現在地。"/><meta property="og:url" content="https://mk9k.a9z.dev/"/><meta property="og:image" content="https://mk9k.a9z.dev/og.png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/>
</head>
<body>
<a class="skip" href="#main">本文へ移動</a>
<header class="wrap"><a class="brand" href="/" aria-label="Misskey 9000 ホーム"><BrandMark class="brandmark" variant="wordmark" /></a><nav aria-label="メインナビゲーション"><a href="#features">できること</a><a href="#development">開発の現在地</a><a href="#upcoming">開発中</a><a class="nav-github" href={repo}>GitHub <ArrowUpRight class="icon" aria-hidden="true" /></a></nav></header>
<main id="main">
<section class="hero wrap" aria-labelledby="hero-title">
<div class="hero-copy"><p class="eyebrow"><span class="dot"></span> A MISSKEY FORK, IN PROGRESS.</p><h1 id="hero-title">いつもの<br/>つながりに、<br/><span>次の工夫を。</span></h1><p class="lead">Misskey の楽しさを受け継いで、<br/>外部ツールとの連携も、サーバー同士の連合も。<br/>分散型 SNS ソフトウェア、<strong>Misskey 9000</strong>。</p><div class="actions"><a class="button primary" href="#start">9k をはじめる <ArrowUpRight class="icon" aria-hidden="true" /></a><a class="text-link" href="#features">特徴を知る <ArrowDown class="icon" aria-hidden="true" /></a></div><a class="release-pill" href={release}><span>PRE-RELEASE</span> 9000.0.0-beta.4 <ArrowUpRight class="icon" aria-hidden="true" /></a></div>
<div class="hero-art" aria-hidden="true"><div class="orbit one"></div><div class="orbit two"></div><span class="art-label top">OPEN SOURCE / FEDERATED</span><BrandMark class="giant" /><ArrowUpRight class="hero-arrow" aria-hidden="true" /><Plus class="satellite a" aria-hidden="true" /><Asterisk class="satellite b" aria-hidden="true" /><span class="art-label bottom">SMALL IDEAS.<br/>MORE POSSIBILITIES.</span><span class="art-index">9000</span></div>
</section>
<div class="ticker" aria-hidden="true"><div>MISSKEY 9000 <Asterisk class="ticker-icon" aria-hidden="true" /> CONNECT, CREATE, MAKE IT YOURS. <Asterisk class="ticker-icon" aria-hidden="true" /> MISSKEY 9000 <Asterisk class="ticker-icon" aria-hidden="true" /> CONNECT, CREATE, MAKE IT YOURS.</div></div>
<section class="intro wrap section"><p class="eyebrow">01 / ABOUT 9k</p><div><h2>Misskey を土台に。<br/>その先を、つくっていく。</h2><p>9k は、Misskey から派生したオープンソースの分散型 SNS ソフトウェアです。Misskey のノートやリアクション、デッキといった体験を土台に、MCP 連携や連合の改善、開発基盤の整理を進めています。</p><p>ひとつの SNS サービスの名前ではなく、サーバーを動かすためのソフトウェア。上流 Misskey と別に開発され、独自のバージョン番号でリリースしています。</p><a class="text-link" href="https://misskey-hub.net/ja/">Misskey と分散型 SNS について <ArrowUpRight class="icon" aria-hidden="true" /></a></div></section>
<section class="features section" id="features"><div class="wrap"><div class="section-head"><div><p class="eyebrow">02 / CONNECT & FEDERATE</p><h2>連携も、連合も。<br/>Misskey の、その先へ。</h2></div><p class="section-note">公開済み beta.4 の主な機能。<br/>日々の体験から、サーバー間のやり取りまで。</p></div><div class="feature-grid">{features.map(([n,title,body,ref,Icon])=><article class="feature"><div class="feature-top"><span class="feature-number">{n}</span><Icon class="feature-icon" size={24} aria-hidden="true" /></div><h3>{title}</h3><p>{body}</p><a href={changes}>{ref} <ArrowUpRight class="icon" aria-hidden="true" /></a></article>)}</div><p class="small">beta.4 では、自分の返信・メンションを自分自身の MCP イベント購読から除外する <a href={`${repo}/pull/215`}>修正 #215</a> と、リスト名を Unicode コードポイント数の 1〜100 文字として扱う <a href={`${repo}/pull/217`}>修正 #217</a> も含まれます。通常の通知・Webhook や、ほかの受信者への MCP 配送は維持します。</p></div></section>
<section class="permission wrap section"><div><p class="eyebrow">03 / YOUR CHOICE</p><h2>連携する権限も、<br/>自分で選ぶ。</h2><p>通常の OAuth でも、明示的な opt-in で権限を選択・追加できるように。MCP の同意画面では任意権限が最初は OFF になり、必要な範囲を選んで連携できます。</p><p class="small">MCP は既定で無効です。利用には enableMcp: true、HTTPS と正しい Host を維持するプロキシ、access:mcp と対象操作の権限が必要です。</p><a class="text-link" href={changes}>仕様と注意点を読む <ArrowUpRight class="icon" aria-hidden="true" /></a></div><figure><img src="/images/oauth-permission-selection.png" alt="連携権限の選択例。アカウント情報、ノート、リアクション、通知、MCP の各権限が OFF で表示されている。" width="720" height="650" loading="lazy"/><figcaption>公開リポジトリ収録の権限選択 UI サンプル。実アカウントへの接続はありません。</figcaption></figure></section>
<section class="development section" id="development"><div class="wrap"><p class="eyebrow">04 / UNDER THE HOOD</p><div class="section-head"><h2>使う体験も、<br/>つくる仕組みも。</h2><p class="section-note">見えるところから、見えないところまで。<br/>上流との差分を、公開の記録で確かめられます。</p></div><div class="tech-grid"><article><span>FEATURE STRUCTURE</span><h3>機能ごとに、まとまる。</h3><p>API・モデル・サービス・画面・ジョブを feature 単位へ。ディレクトリ構造を見直し、依存関係の組み立てと責務を整理しています。</p></article><article><span>oRPC / VALIBOT</span><h3>契約から、型を導く。</h3><p>oRPC / Valibot の契約から API・misskey-js の型・ルーティング情報を導出。従来の再帰的な JSON Schema・SchemaType・ajv などを置き換え、API の互換性は維持しています。</p></article><article><span>VVI / LOCALIZATION</span><h3>翻訳を、テンプレートのそばに。</h3><p>クライアントの i18n に VVI を採用。コンポーネントや TypeScript の翻訳を、テンプレートや機能ごとに管理します。言語別 JavaScript コピーと移行済みの重複翻訳キーも整理しています。</p></article></div><p class="evidence">掲載内容は <a href={release}>公開済み beta.4</a> と、<a href={currentChanges}>同じタグの CHANGELOG（31f01db）</a> に基づきます。以後の develop や未マージの提案とは区別しています。</p></div></section>
<section class="proposals section" id="upcoming" aria-labelledby="upcoming-title"><div class="wrap"><div class="section-head"><div><p class="eyebrow">05 / WORK IN PROGRESS</p><h2 id="upcoming-title">開発中の取り組みを、<br/>のぞいてみる。</h2></div><p class="section-note">ここからは未マージの公開 PR。<br/>beta.4 の提供済み機能には含まれません。</p></div><p class="proposal-intro">実装や検証を進めている取り組みを紹介します。仕様・採用・提供時期は未確定です。それぞれの PR で、現在の内容と議論を確認できます。</p><div class="proposals-grid"><article class="feature proposal"><div class="proposal-top"><Wallet size={24} aria-hidden="true" /><span>Draft / 未マージ</span></div><h3>課金・ウォレット・P2P 送金</h3><p>ウォレットの所有確認、サーバー課金の購入・更新・返金、ユーザー間の ERC20 送金と受取設定を扱う提案です。3つの PR に分けて開発されており、beta.4 では利用できません。</p><div class="proposal-links"><a href={`${repo}/pull/64`}>ウォレット #64 <ArrowUpRight class="icon" aria-hidden="true" /></a><a href={`${repo}/pull/81`}>サーバー課金 #81 <ArrowUpRight class="icon" aria-hidden="true" /></a><a href={`${repo}/pull/126`}>P2P 送金 #126 <ArrowUpRight class="icon" aria-hidden="true" /></a></div></article><article class="feature proposal"><div class="proposal-top"><MessagesSquare size={24} aria-hidden="true" /><span>Open PR / 未マージ</span></div><h3>チャンネルを、別の 9k へ。</h3><p>公開チャンネルを別の 9k サーバーから購読し、投稿と作者による削除を受け取る連合の試作です。リモートからの投稿や、チャンネル所有者による他人の投稿削除などは対象外です。</p><div class="proposal-links"><a href={`${repo}/pull/136`}>チャンネル連合 #136 <ArrowUpRight class="icon" aria-hidden="true" /></a></div></article><article class="feature proposal"><div class="proposal-top"><ShieldCheck size={24} aria-hidden="true" /><span>Draft / 未マージ</span></div><h3>重要な操作の本人確認を整理。</h3><p>重要なアカウント操作の本人確認を共通化し、独立したパスキー MFA、セッション管理、トークンの有効期限を扱う提案です。復旧コードの一回消費も別 PR で開発中。OIDC SSO はこの提案の対象外です。</p><div class="proposal-links"><a href={`${repo}/pull/188`}>認証の見直し #188 <ArrowUpRight class="icon" aria-hidden="true" /></a><a href={`${repo}/pull/146`}>復旧コード #146 <ArrowUpRight class="icon" aria-hidden="true" /></a></div></article></div><p class="small">PR の状態は2026年10月20日時点で確認しています。ここで紹介する機能の提供やリリース日を約束するものではありません。<a href={`${repo}/pulls`}>公開 PR 一覧を見る <ArrowUpRight class="icon" aria-hidden="true" /></a></p></div></section>
<section class="start wrap section" id="start"><p class="eyebrow">06 / GET STARTED</p><h2>次の一歩を、<br/>ここから。</h2><p>まずはコードと変更点をのぞいてみる。<br/>自分のサーバーで試すなら、検証環境から。</p><div class="start-grid"><a href={repo}><span>EXPLORE</span><h3>GitHub で見る <ArrowUpRight class="card-arrow" aria-hidden="true" /></h3><p>ソースコード・Issue・開発への参加</p></a><a href={`${repo}/blob/9000.0.0-beta.4/CONTRIBUTING.md`}><span>BUILD & INSTALL</span><h3>導入・開発ガイド <ArrowUpRight class="card-arrow" aria-hidden="true" /></h3><p>beta.4 タグの手順と必要環境を確認</p></a></div><p class="small">beta.4 の開発環境指定は Node.js 26.4.0 / pnpm 12.11.2 です。SDK・Docker の配布状況は GitHub prerelease とは別です。導入時はリリースノートと利用するタグ・commit の手順を確認してください。既存サーバーの更新前には、データベース・設定・アップロードファイルのバックアップと、検証環境でのビルド・migration・起動確認が必要です。導入手順は <a href="https://misskey-hub.net/ja/docs/for-admin/install/">Misskey Hub</a> も参考に、9k 側の要件を優先してください。</p></section>
</main><footer class="wrap"><a class="brand" href="/" aria-label="Misskey 9000 ホーム"><BrandMark class="brandmark" variant="wordmark" /></a><p>Built on Misskey. Open source, moving forward.</p><a href={repo}>Source / AGPL-3.0 <ArrowUpRight class="icon" aria-hidden="true" /></a></footer>
</body></html>
