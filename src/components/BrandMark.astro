---
import Mark from '../assets/mi9k-mark.svg';
import Wordmark from '../assets/misskey9000-wordmark.svg';
interface Props { class?: string; variant?: 'mark' | 'wordmark'; }
const { class: className, variant = 'mark' } = Astro.props;
const Logo = variant === 'wordmark' ? Wordmark : Mark;
---
<Logo class={className} aria-hidden="true" focusable="false" />
